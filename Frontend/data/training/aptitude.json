      "difficulty": "Beginner",
      "estimatedTime": "20–30 min",
      "learn": {
        "title": "Percentages",
        "sections": [
          {
            "heading": "Core idea",
            "content": "Percentage means a value out of 100."
          },
          {
            "heading": "Formula",
            "content": "Percentage = Part ÷ Whole × 100."
          }
        ]
      },
